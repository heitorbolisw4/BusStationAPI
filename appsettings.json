{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "User": {
      "Issuer": "BusStationApi",
      "Audience": "BusStationUsers",
      "ExpirationTimeInMinutes": 15,
      "RefreshExpirationTimeInMinutes": 10080
    },
    "Admin": {
      "Issuer": "BusStationApi",
      "Audience": "BusStationAdmins"
    }
  }
}
