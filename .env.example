# Copie para .env (gitignored) e preencha. Usado só pelo docker-compose local.
POSTGRES_PASSWORD=
# no mínimo 32 caracteres cada: openssl rand -base64 48
JWT_USER_SECRET_KEY=
JWT_ADMIN_SECRET_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173
# opcional: primeiro admin (só é criado se não existir nenhum)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
